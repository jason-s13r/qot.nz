extends ../layout/page.pug

block vars
  - var page = { title: "Contact · Qot. games", description: "How to get in touch about Qot. games: bugs, game ideas and privacy questions.", path: "/contact" }

block main
  main
    h1.page-title Contact
    .prose
      p Found a bug, got an idea for a game, or have a question about privacy? Get in touch.
      h2 Email
      p
        span.email jason@qot.nz
      p For a bug, it helps to say which game it was, what device and browser you were using, and what happened. A screenshot is great too.
      h2 Other ways
      ul
        li
          | Leave a message with a tip on 
          a(href="https://ko-fi.com/jason_s13r", target="_blank", rel="noopener") Ko-fi
          | .
        li
          | Find Jason on his own site, 
          a(href="https://jason.schwarzenberger.co.nz/", target="_blank", rel="noopener") jason.schwarzenberger.co.nz
          | .
      h2 Privacy questions
      p
        | The 
        a(href="/privacy") privacy page
        |  covers how qot.nz and the games handle your data, with links to each game’s own privacy page.
