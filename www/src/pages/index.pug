extends ../layout/page.pug

block vars
  - var page = { title: "Qot. games", description: "Little web games made in New Zealand: Tessera, a grid territory game played solo or online, Juice Factory, a juice-making clicker game, Trick or Treat, a co-op Halloween game for kids, Summer Santa, a co-op Santa game, Egg Hunt, a co-op Easter game, and Fuse 0xAC, a puzzle game about guarding one number.", path: "/", fonts: allGameFonts }

block main
  main#games
    h1.intro Free games to play in your browser.
    ul.shelf
      each g in games
        +gameCard(g)
