//- Any other content/*.md page: a heading and the text.
extends base.pug

block vars
  - var page = { title: `${doc.title} · Qot. games`, description: doc.description, path: doc.path }

block main
  main
    h1.page-title!= doc.headingHtml
    .prose
      if doc.updated
        p.updated Last updated #{doc.updated}
      != doc.html
